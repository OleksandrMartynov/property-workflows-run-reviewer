{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Skill(run-reviewer)",
      "Skill(run-reviewer *)",
      "Agent(run-review-verifier)",
      "Bash(node scripts/review.mjs *)",
      "Edit(/out/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/tests/**)",
      "Read(/docs/**)",
      "Read(/.git/**)",
      "Edit(/data/**)",
      "Edit(/scripts/**)",
      "Edit(/references/**)",
      "Edit(/tests/**)",
      "Edit(/docs/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/README.md)",
      "Edit(/run.sh)",
      "Edit(/run-golden.sh)",
      "Edit(/package.json)",
      "Edit(/out/runs/**)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node tests/*)",
      "Bash(npm *)",
      "Bash(npx *)"
    ]
  }
}
